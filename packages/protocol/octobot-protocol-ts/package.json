{
  "name": "@drakkarsoftware/octobot-protocol",
  "version": "0.1.0",
  "description": "TypeScript types for OctoBot protocol — generated from packages/protocol/openapi.json",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": ["dist", "src"],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "generate": "cd .. && npm run generate:typescript",
    "tsBuild": "tsc",
    "bundle-cjs": "rollup -c rollup.config.js",
    "build": "npm run tsBuild && npm run bundle-cjs",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "rollup": "^4.12.0",
    "typescript": "^5.4.0"
  },
  "license": "LGPL-3.0",
  "publishConfig": { "registry": "https://registry.npmjs.com" }
}
