# Supabase credentials (service-role key bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# S3-compatible storage (Garage / MinIO / AWS)
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=octobot-sync
S3_ACCESS_KEY=GKxxxxxxxxxxxxxxxx
S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_REGION=garage

# Optional: override collections.json path
# COLLECTIONS_JSON=/path/to/collections.json

# Optional: incremental state file path
# STATE_FILE=.import_state.json
